<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF3FC">

    <TextView
        android:id="@+id/txtCallTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LLAMADA DE EMERGENCIA"
        android:textColor="#17365D"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_margin="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtCallPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Número de emergencia"
        android:textColor="#17365D"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_margin="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtCallTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btnMakeCall"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/png_llamar"
        android:contentDescription="Iniciar llamada"
        android:backgroundTint="#FFFFFF"
        android:scaleType="fitCenter"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtCallPhone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.25" />

</androidx.constraintlayout.widget.ConstraintLayout>